; Engine configuration file.
; OmniVerse - Godot 4.7

config_version=5

[application]

config/name="OmniVerse"
config/description="Third-person arena brawler. Mutate with the Mutrix, fight your friends."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.12, 1)
